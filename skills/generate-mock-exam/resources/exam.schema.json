{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mock-exam.schema.json",
  "title": "Mock exam",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "domains",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source_note": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "pass_score_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "time_limit_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "string",
            "description": "Free text, e.g. '25-30%'"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "domain": {
            "type": "string",
            "description": "A domains[].id"
          },
          "topic": {
            "type": "string",
            "description": "A topics[].id within that domain"
          },
          "type": {
            "enum": [
              "single",
              "multiple",
              "ordering",
              "matching",
              "yesno-series",
              "hotspot",
              "command"
            ],
            "default": "single"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-H]$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "explanation": {
                  "type": "string",
                  "description": "Why this option is right or wrong"
                }
              }
            }
          },
          "correct": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-H]$"
            }
          },
          "explanation": {
            "type": "string",
            "description": "Why the correct answer is correct"
          },
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-H]$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "explanation": {
                  "type": "string"
                }
              }
            }
          },
          "correct_order": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-H]$"
            },
            "description": "ordering: item ids in the correct sequence"
          },
          "prompts": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[1-8]$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "explanation": {
                  "type": "string"
                }
              }
            }
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-H]$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "correct_pairs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "prompt",
                "choice"
              ],
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "type": "string",
                  "pattern": "^[1-8]$"
                },
                "choice": {
                  "type": "string",
                  "pattern": "^[A-H]$"
                }
              }
            },
            "description": "matching: one pair per prompt; a choice may be reused"
          },
          "statements": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "answer"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^S[1-8]$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "answer": {
                  "type": "boolean"
                },
                "explanation": {
                  "type": "string"
                }
              }
            }
          },
          "slots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "description": "hotspot: each slot is a dropdown with one correct option",
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "options",
                "correct"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^H[1-6]$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-H]$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "explanation": {
                        "type": "string"
                      }
                    }
                  }
                },
                "correct": {
                  "type": "string",
                  "pattern": "^[A-H]$"
                },
                "explanation": {
                  "type": "string"
                }
              }
            }
          },
          "command": {
            "type": "object",
            "required": [
              "shell",
              "accepted"
            ],
            "additionalProperties": false,
            "description": "command: free-text answer graded against accepted variants",
            "properties": {
              "shell": {
                "enum": [
                  "azure-cli",
                  "powershell",
                  "bash",
                  "cmd"
                ]
              },
              "accepted": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ignore_flag_order": {
                "type": "boolean",
                "default": true
              },
              "case_sensitive": {
                "type": "boolean",
                "default": false
              },
              "hint": {
                "type": "string"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "not": {
                    "required": [
                      "type"
                    ]
                  }
                },
                {
                  "properties": {
                    "type": {
                      "enum": [
                        "single",
                        "multiple"
                      ]
                    }
                  }
                }
              ]
            },
            "then": {
              "required": [
                "options",
                "correct"
              ]
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "ordering"
                }
              }
            },
            "then": {
              "required": [
                "items",
                "correct_order"
              ]
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "matching"
                }
              }
            },
            "then": {
              "required": [
                "prompts",
                "choices",
                "correct_pairs"
              ]
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "yesno-series"
                }
              }
            },
            "then": {
              "required": [
                "statements"
              ]
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "hotspot"
                }
              }
            },
            "then": {
              "required": [
                "slots"
              ]
            }
          },
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "command"
                }
              }
            },
            "then": {
              "required": [
                "command"
              ]
            }
          }
        ]
      }
    }
  }
}
