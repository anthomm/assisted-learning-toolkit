{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mock-exam.schema.json",
  "title": "Mock exam",
  "type": "object",
  "required": ["schema_version", "id", "title", "domains", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source_note": { "type": "string" },
    "language": { "type": "string", "default": "en" },
    "pass_score_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "time_limit_minutes": { "type": "number", "exclusiveMinimum": 0 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "weight": { "type": "string", "description": "Free text, e.g. '25-30%'" },
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "title": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "domain", "text", "options", "correct"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "domain": { "type": "string", "description": "A domains[].id" },
          "topic": { "type": "string", "description": "A topics[].id within that domain" },
          "type": { "enum": ["single", "multiple"], "default": "single" },
          "text": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[A-H]$" },
                "text": { "type": "string", "minLength": 1 },
                "explanation": { "type": "string", "description": "Why this option is right or wrong" }
              }
            }
          },
          "correct": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-H]$" }
          },
          "explanation": { "type": "string", "description": "Why the correct answer is correct" },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "references": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
